# Copie para .env.local e preencha. Sem estes dois valores o app abre em modo
# demonstracao, lendo a central do minerador local.
#
# Use a chave PUBLICA do projeto (anon / publishable). Nunca a chave secreta:
# tudo o que esta neste arquivo vai para o navegador de quem abrir o site.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=

# Opcional. Endereco https do botao de cotacao; {pedido} vira o texto do pedido.
# VITE_COTACAO_URL=https://wa.me/55DDDNUMERO?text={pedido}
